NODE_ENV=production
PORT=5000

# MongoDB Authentication (used by mongo container's MONGO_INITDB_ROOT_*)
MONGO_USERNAME=replace_with_mongo_admin_username
MONGO_PASSWORD=replace_with_strong_random_mongo_password

# Connection string must include credentials and authSource
MONGO_URI=mongodb://replace_with_mongo_admin_username:replace_with_strong_random_mongo_password@mongo:27017/dockerDB?authSource=admin

JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:80
